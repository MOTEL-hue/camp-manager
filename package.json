{
  "name": "camp-manager",
  "productName": "ניהול קייטנות ומכירות",
  "version": "1.10.0",
  "description": "ניהול רשימות, רישום, רכישות, תשלומים, הוצאות וסיכומים",
  "main": "main.js",
  "author": "MOTEL-hue",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "4.10.38",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.motelhue.campmanager",
    "productName": "ניהול קייטנות ומכירות",
    "executableName": "camp-manager",
    "artifactName": "camp-manager-setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "updatelib.js",
      "apply-update.js",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "!node_modules/pdfjs-dist/{legacy,cmaps,standard_fonts,web,types,image_decoders,wasm}/**",
      "!node_modules/pdfjs-dist/build/{*.map,pdf.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs}",
      "!node_modules/xlsx/{xlsx.js,xlsx.mjs,xlsx.flow.js,jszip.js,bin,types,tests}/**",
      "!node_modules/xlsx/{xlsx.js,xlsx.mjs,xlsx.flow.js,jszip.js}",
      "!node_modules/xlsx/dist/{cpexcel.full.mjs,cpexcel.js,shim.min.js,xlsx.core.min.js,xlsx.core.min.map,xlsx.extendscript.js,xlsx.full.min.map,xlsx.mini.min.js,xlsx.mini.min.map,xlsx.zahl.js,xlsx.zahl.mjs}",
      "!node_modules/@napi-rs/**",
      "!node_modules/{codepage,cfb,frac,crc-32,ssf,adler-32,wmf,word}/**",
      "!node_modules/xlsx/{bower.json,xlsxworker.js,formats.png,legend.png}",
      "!node_modules/pdfjs-dist/{webpack.mjs,CODE_OF_CONDUCT.md}",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "language": "1037",
      "installerLanguages": [
        "he_IL"
      ],
      "multiLanguageInstaller": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ניהול קייטנות ומכירות",
      "runAfterFinish": true,
      "artifactName": "camp-manager-setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MOTEL-hue",
        "repo": "camp-manager",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "camp-manager-portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "electronLanguages": [
      "he",
      "en-US"
    ],
    "compression": "maximum"
  }
}
